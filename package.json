{
  "name": "rem-ai-design",
  "version": "0.4.1",
  "description": "RMDL — RemMai Design Language standard, agent entrypoints and scaffolding CLI",
  "type": "module",
  "bin": {
    "remdl": "./bin/rem.mjs",
    "rem": "./bin/rem.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "scripts/npm-mode.mjs",
    "standard/",
    "VERSION",
    "README.md"
  ],
  "scripts": {
    "check": "node scripts/check-repo.mjs",
    "test": "node --test tests/rmdl-guard.test.mjs tests/rmdl-bootstrap.test.mjs tests/rmdl-npm.test.mjs",
    "prepack": "node scripts/prepack.mjs",
    "pack:dry": "node scripts/prepack.mjs && npm pack --dry-run"
  },
  "keywords": [
    "rmdl",
    "remmai",
    "design-system",
    "scaffold",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RemMai/remmai-design-system.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "UNLICENSED"
}
