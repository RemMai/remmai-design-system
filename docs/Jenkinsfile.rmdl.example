pipeline {
  agent any
  stages {
    stage('RMDL Policy') {
      steps { sh 'node scripts/rmdl.mjs check' }
    }
    stage('RMDL Guard Tests') {
      steps { sh 'node --test tests/rmdl-guard.test.mjs' }
    }
    // Use the project's pinned Node.js LTS/npm; add npm ci, typecheck, lint,
    // tests, build and Playwright visual in the package-lock.json workspace
    // once the actual apps/web workspace has been initialized.
  }
}
